# Copia este archivo a .env y ajusta lo que necesites.
# Con todo vacío, SpendGuard corre en modo mock (sin keys, sin red).

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# "mock" = Reap simulado en memoria. "live" = API real de Reap en sandbox.
REAP_MODE=mock

# Solo para REAP_MODE=live. La key te la entregan en el evento (líder del equipo).
# Confirma con Jose (Reap) si tu key es de México o de Singapur:
#   https://mx.sandbox.api.reap.global   |   https://sg.sandbox.api.reap.global
REAP_BASE_URL=https://mx.sandbox.api.reap.global
REAP_API_KEY=
REAP_VERSION=2025-02-14

DATA_FILE=data/store.json
POLICY_FILE=policies/default.policy.json
POLL_INTERVAL_MS=5000

# Dirección de envío por defecto para las cotizaciones de Reap.
# En el sandbox live, cada merchant solo cotiza si la dirección es una a la que esa tienda envía:
# los organizadores recomiendan tiendas de EE.UU., así que por defecto usamos una dirección ficticia en EE.UU.
# Déjalas vacías para usar los defaults (1 Market Street, San Francisco, CA 94105, US). Nunca pongas datos reales sensibles.
SHIP_FIRST_NAME=
SHIP_LAST_NAME=
SHIP_PHONE=
SHIP_ADDRESS1=
SHIP_ADDRESS2=
SHIP_CITY=
SHIP_REGION=
SHIP_POSTAL_CODE=
SHIP_COUNTRY=
