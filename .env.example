# Copia este archivo a .env y ajusta lo que necesites.
# Con todo vacío, SpendGuard corre en modo mock (sin keys, sin red).

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# "mock" = Reap simulado en memoria. "live" = API real de Reap en sandbox.
REAP_MODE=mock

# Solo para REAP_MODE=live. La key te la entregan en el evento (líder del equipo).
# Confirma con Jose (Reap) si tu key es de México o de Singapur:
#   https://mx.sandbox.api.reap.global   |   https://sg.sandbox.api.reap.global
REAP_BASE_URL=https://mx.sandbox.api.reap.global
REAP_API_KEY=
REAP_VERSION=2025-02-14

# Opcional: con key usa el agente Claude; sin key usa un agente de reglas (demo).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

DATA_FILE=data/store.json
POLICY_FILE=policies/default.policy.json
POLL_INTERVAL_MS=5000
