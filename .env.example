# Copia este archivo a .env y ajusta lo que necesites.
# Con todo vacío, SpendGuard corre en modo mock (sin keys, sin red).

PORT=3000
# Interfaz donde escucha. Vacío = localhost (solo esta máquina). El dashboard aprueba gastos y no tiene login:
# usa 0.0.0.0 solo si de verdad necesitas abrirlo a tu red (por ejemplo, una demo desde el teléfono).
HOST=
PUBLIC_BASE_URL=http://localhost:3000

# "mock" = Reap simulado en memoria. "live" = API real de Reap en sandbox.
REAP_MODE=mock

# Solo para REAP_MODE=live. La key te la entregan en el evento (líder del equipo).
# Confirma con Jose (Reap) si tu key es de México o de Singapur:
#   https://mx.sandbox.api.reap.global   |   https://sg.sandbox.api.reap.global
REAP_BASE_URL=https://mx.sandbox.api.reap.global
REAP_API_KEY=
REAP_VERSION=2025-02-14
# Correo que se manda a Reap en cotizaciones y checkouts en lugar del solicitante.
# Reap rechaza dominios reservados (.test, .example): los usuarios demo (ana@acme.test) necesitan este valor en live.
REAP_CONTACT_EMAIL=
# Enrollment de Reap (la tarjeta de la empresa, registrada una vez en la página de Reap). Obligatorio en live:
# se crea con POST /agentic/enrollments y debe estar ACTIVE.
REAP_ENROLLMENT_ID=
# En live, Reap solo acepta returnUrl HTTPS: PUBLIC_BASE_URL debe empezar con https://
# "simulated" = búsqueda y cotización reales de Reap, pero la página donde el titular autoriza el cargo es simulada
# (y lo dice). Para cuando no se pudo activar un enrollment. Con "simulated", PUBLIC_BASE_URL puede ser http://localhost.
REAP_CHECKOUT=live
# Solo sandbox: manda X-Simulate-Checkout en cada checkout para que Reap complete la orden sin comprarle a la tienda
# (las tarjetas de prueba se rechazan en tiendas reales, y sin esto el checkout termina FAILED). Producción lo rechaza.
REAP_SIMULATE_CHECKOUT=COMPLETED

DATA_FILE=data/store.json
POLICY_FILE=policies/default.policy.json
POLL_INTERVAL_MS=5000

# Dirección de envío por defecto para las cotizaciones de Reap.
# En el sandbox live, cada merchant solo cotiza si la dirección es una a la que esa tienda envía:
# los organizadores recomiendan tiendas de EE.UU., así que por defecto usamos una dirección ficticia en EE.UU.
# Déjalas vacías para usar los defaults (1 Market Street, San Francisco, CA 94105, US). Nunca pongas datos reales sensibles.
SHIP_FIRST_NAME=
SHIP_LAST_NAME=
SHIP_PHONE=
SHIP_ADDRESS1=
SHIP_ADDRESS2=
SHIP_CITY=
SHIP_REGION=
SHIP_POSTAL_CODE=
SHIP_COUNTRY=
