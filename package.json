{
  "name": "spendguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capa de políticas de gasto para agentes de IA sobre el Agentic module de Reap",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
